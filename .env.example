# Скопируй в .env и заполни. .env в гит не попадает (см. .gitignore) —
# на локальной машине и на проде значения разные, никаких .env.production
# и т.п. не нужно: просто на каждой машине свой .env.

# ─── Backend
PORT=3000
HOST=0.0.0.0
# Адрес, на котором крутится сервер.
APP_URL=http://localhost:3000

UPLOADS_DIR=./data/uploads
MAX_FILE_MB=100

# Пароль для входа в /admin — без него панель недоступна вообще.
ADMIN_PASSWORD=change-me

# Сколько дней завершённая карточка канбана лежит перед автопереносом в архив
KANBAN_ARCHIVE_AFTER_DAYS=3

# ─── Frontend (Vite, должны начинаться с VITE_)
VITE_API_URL=http://localhost:3000
