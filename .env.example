# Скопируй в .env и заполни. .env в гит не попадает (см. .gitignore).

# ═══ Как устроены адреса (кратко) ═══════════════════════════
# Браузер, dev:     npm run dev (5173) + npm run server (3000)
#   → VITE_API_URL не задавай — запросы /api/* проксируются Vite на :3000
# Браузер, prod:    https://твой-хост → nginx:443 → контейнер :3000
#   → VITE_API_URL не нужен в Docker-сборке (SPA и API с одного origin)
# Electron, dev:    npm run start → UI :5173, API через прокси + preload :3000
# Electron, prod:   CI пишет .env.production с VITE_API_URL=https://твой-хост
#   → тот же URL попадает в dist/server-url.json для main-процесса
#   → для самоподписанного HTTPS Electron доверяет cert только этому хосту

# ─── Backend ────────────────────────────────────────────────
PORT=3000
HOST=0.0.0.0
# Публичный URL сервера (логи, ссылки в письмах/OG). За nginx — https://…
# ЛОКАЛЬНО:  http://localhost:3000
# ПРОД:      https://172.16.99.37  (или workvault.local)
APP_URL=http://localhost:3000

# ─── Frontend / Electron (только если нужен явный origin) ───
# Локально обычно ПУСТО. Для сборки Windows-клиента в CI задаётся автоматически.
# VITE_API_URL=https://172.16.99.37
# Переопределение URL бэкенда для main-процесса Electron (редко нужно вручную):
# WORKVAULT_SERVER_URL=https://172.16.99.37

UPLOADS_DIR=./data/uploads
MAX_FILE_MB=100

# Одноразовый мастер-ключ для назначения самого первого админа
# (POST /api/auth/bootstrap-admin) — НЕ пароль от какого-либо аккаунта.
ADMIN_PASSWORD=change-me

# Сколько дней завершённая карточка канбана лежит перед автопереносом в архив
KANBAN_ARCHIVE_AFTER_DAYS=3

# ─── Auth (JWT) ───────────────────────────────────────────────
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Обязательно свой на каждом окружении, не хранить в гите, не переиспользовать.
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
# true — только когда сервер реально висит за HTTPS (nginx + сертификат).
# На голом HTTP держим false, иначе браузер вообще не отправит cookie.
COOKIE_SECURE=false