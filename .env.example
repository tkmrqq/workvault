# Скопируй в .env и заполни. .env в гит не попадает (см. .gitignore) —
# на локальной машине и на проде значения разные, никаких .env.production
# и т.п. не нужно: просто на каждой машине свой .env.

# ─── Backend ────────────────────────────────────────────────
PORT=3000
HOST=0.0.0.0
# Публичный адрес, на котором крутится сервер.
# ЛОКАЛЬНО:  http://localhost:3000
# ПРОД:      http://172.16.99.37:3000
APP_URL=http://localhost:3000

UPLOADS_DIR=./data/uploads
MAX_FILE_MB=100

# Одноразовый мастер-ключ для назначения самого первого админа
# (POST /api/auth/bootstrap-admin) — НЕ пароль от какого-либо аккаунта.
ADMIN_PASSWORD=change-me

# Сколько дней завершённая карточка канбана лежит перед автопереносом в архив
KANBAN_ARCHIVE_AFTER_DAYS=3

# ─── Auth (JWT) ───────────────────────────────────────────────
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Обязательно свой на каждом окружении, не хранить в гите, не переиспользовать.
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
# true — только когда сервер реально висит за HTTPS (nginx + сертификат).
# На голом HTTP держим false, иначе браузер вообще не отправит cookie.
COOKIE_SECURE=false