{
  "name": "workvault",
  "version": "1.0.0",
  "description": "Командный мессенджер с каналами",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron": "electron .",

    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "server": "node server/server.js",
    "start": "concurrently \"npm run server\" \"npm run electron:dev\""
  },
  "dependencies": {
    "better-sqlite3": "^9.4.3",
    "cors": "^2.8.5",
    "express": "^4.18.3",
    "multer": "^1.4.5-lts.1",
    "open-graph-scraper": "^6.3.3",
    "socket.io": "^4.7.4",
    "socket.io-client": "^4.7.4"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.4",
    "concurrently": "^8.2.2",
    "electron": "^29.1.4",
    "electron-builder": "^24.13.3",
    "vite": "^5.1.6",
    "vue": "^3.4.21",
    "pinia": "^2.1.7",
    "vue-router": "^4.3.0",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.team.workvault",
    "productName": "WorkVault",
    "directories": { "output": "dist-electron" },
    "files": ["dist/**/*", "electron/**/*", "server/**/*"],
    "win": { "target": "nsis" },
    "mac": { "target": "dmg" },
    "linux": { "target": "AppImage" }
  }
}
