# Server
PORT=3000
HOST=0.0.0.0

# Публичный URL приложения (без слеша в конце)
# DEV:  http://localhost:3000
# PROD: https://workvault.yourdomain.com
APP_URL=http://localhost:3000

# Папка для загрузок (по умолчанию ./data/uploads)
UPLOADS_DIR=./data/uploads

# Максимальный размер файла в МБ
MAX_FILE_MB=100